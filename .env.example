# CricketIQ Environment Configuration Example

# Roboflow Hosted Inference API (Object Detection: batter, bowler, non_striker, bat, ball, stumps)
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_MODEL_ID=nikunjs-workspace-a3ulh/cricketiq-1-rfdetr-small-t1
ROBOFLOW_BASE_URL=https://detect.roboflow.com
ROBOFLOW_CONFIDENCE_THRESHOLD=0.35
ROBOFLOW_MAX_CALLS_PER_VIDEO=15

# Server & Runtime Configuration
HOST=127.0.0.1
PORT=8000
MAX_UPLOAD_SIZE_MB=150
MAX_VIDEO_DURATION_SEC=30.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,*
